# ==============================================================================
# TicketWala Environment Configuration Template
# Copy this file to .env or .env.production and populate real secrets.
# NEVER commit production credentials to Git!
# ==============================================================================

# Server & Application Runtime
PORT=8000
APP_ENV=development # development | test | production
LOG_LEVEL=info # debug | info | warn | error
CORS_ORIGINS=http://localhost:3000,https://ticketwala.onrender.com

# ------------------------------------------------------------------------------
# Supabase Postgres Configuration (Durable Relational Ledger)
# ------------------------------------------------------------------------------
# Transaction Pooler (Port 6543 via Supavisor) - Used by API Service
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Direct Connection (Port 5432) - Used by Migrations & Background Worker
DATABASE_DIRECT_URL=postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Database Connection Pool Limits
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=15

# ------------------------------------------------------------------------------
# Upstash Redis Configuration (In-Memory Transactional Broker & Streams)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:[TOKEN]@[ENDPOINT].upstash.io:6379
REDIS_MAX_RETRIES=5
REDIS_CONNECT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Dynamic Capacity & Invariant Tuning
# ------------------------------------------------------------------------------
DEFAULT_EVENT_CAPACITY=200
BASE_TOKEN_BUCKET_CAPACITY=1000
BASE_REFILL_RATE_PER_SEC=500
RESERVATION_TTL_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=600

# Background Worker Settings
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=2
WORKER_CLAIM_INTERVAL_MS=5000
AUDIT_INTERVAL_SECONDS=30
